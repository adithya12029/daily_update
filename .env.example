# Copy this file to `.env` and fill in your real values.
# Never commit the real .env file to version control.

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Gmail address that will SEND the digest
GMAIL_USER=your_email@gmail.com

# A 16-character Gmail "App Password" (NOT your normal Gmail password).
# See the setup instructions for how to generate one.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# The address that will RECEIVE the digest (can be the same as GMAIL_USER)
RECIPIENT_EMAIL=recipient_email@gmail.com
